---
import LinkInline from "./LinkInline.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
}

const { title, company, description, link, date } = Astro.props
---

<div class="experience-heading">
  <h3>{title}</h3>
  <h4>{company}</h4>
  <time>{date}</time>
</div>
<div class="experience-description">
  <Fragment set:html={description.replace(/<li>•\s*/g, '<li>')} />
  {link && <LinkInline href={link}>Saber más →</LinkInline>}
</div>
