---
import { getTranslations } from "@/i18n/i18n";
const { lang = 'es' } = Astro.props;
const projects = getTranslations(lang).projects;
---
<div class="projects-list">
  {projects.map((project, index) => (
    <article class="project-card">
      <div class:list={["project-image", { "project-repsol": project.current }]}>
        {project.image ? (
          <img src={project.image} alt={project.title} loading="lazy" />
        ) : (
          <div class="project-client">
            <span class="project-client-label">Accenture / {lang === 'es' ? 'Sector energético' : 'Energy sector'}</span>
            <span class="project-client-name">Repsol<span aria-hidden="true">.</span></span>
            <span class="project-client-specialty">Salesforce Administration</span>
          </div>
        )}
      </div>
      <div class="project-content">
        <span class="project-number">{lang === 'es' ? 'PROYECTO' : 'PROJECT'} / {String(index + 1).padStart(2, '0')}</span>
        {project.current && <span class="project-current">{lang === 'es' ? 'Proyecto actual' : 'Current project'} · {project.period}</span>}
        <h3>{project.title}</h3>
        <p set:html={project.description}></p>
        <a class="project-link" href={project.link}>{project.linkText}<span aria-hidden="true">↗</span></a>
      </div>
    </article>
  ))}
</div>
