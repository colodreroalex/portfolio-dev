---
import { getTranslations } from "@/i18n/i18n";

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <span>
      &copy; {currentYear} 
      <a href="https://www.linkedin.com/in/alejandro-colodrero-garc%C3%ADa/" class="hover:underline">
        Alejandro Colodrero
      </a>. {t.footer.rights}
    </span>
    
    <ul>
      <li>
      <a href={`${lang === "en" ? "/en/" : "/"}#sobre-mi`} class="hover:underline">{t.footer.aboutMe}</a>
      </li>
      <li>
      <a id="contacto" href="mailto:damalexcolo@gmail.com" class="hover:underline">{t.footer.contact}</a>
      </li>
      <li>
      <a href="/Alejandro_Colodrero_CV.pdf" download class="hover:underline">{t.footer.downloadCV}</a>
      </li>
    </ul>
  </div>
</footer>
