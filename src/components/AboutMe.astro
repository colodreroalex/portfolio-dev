---
import { getTranslations } from "@/i18n/i18n";

const { lang = 'es' } = Astro.props;
const t = getTranslations(lang);
const personalImageAlt = "Alejandro Colodrero";
---

<article
  class="about-content"
>
  <div
    class="about-copy"
  >
    <p set:html={t.aboutMe.paragraph1}></p>

    <p set:html={t.aboutMe.paragraph2}></p>

    <p set:html={t.aboutMe.paragraph3}></p>
  </div>

  <img
    width="200"
    height="200"
    src="/yoTraje.png"
    alt={personalImageAlt}
    class="about-photo"
    style="object-position: 50% 15%"
  />
</article>
